<!--pages/index/index.wxml-->
<view class="page-container">
<!--订阅消息部分-->

<!--头部部分-->
<view class="header">
  <view class="header-air">
    <view>
    空气质量-良
    </view>
    <view>
    福建-南安
    </view>
  </view>
  <view class="header-title">
    <view>
      {{temp}}
    </view>
    <view>
    晴
    </view>
  </view>
  <view class="header-ad">
    天气晴朗
  </view>
 </view>
<!--数据部分-->
<view class="data-container">
<!--温度-->
  <view class="data-card">
    <image class="data-card-icon" src="/static/temp.png"/><!--图标设置-->
    <view>
      <view class="data-card-title">
        温度
      </view>
      <view class="data-card-value">
        {{temp}} ℃
      </view>
    </view>
  </view>
<!--湿度-->
  <view class="data-card">
    <image class="data-card-icon" src="/static/humi.png"/><!--图标设置-->
    <view>
      <view class="data-card-title">
        湿度
      </view>
      <view class="data-card-value">
        {{humi}} %
      </view>
    </view>
  </view>
<!--光照-->
  <view class="data-card">
    <image class="data-card-icon" src="/static/light.png"/><!--图标设置-->
    <view>
      <view class="data-card-title">
        光照
      </view>
      <view class="data-card-value">
        {{heart}} Lux
      </view>
    </view>
  </view>
  <!--PH-->
  <view class="data-card">
    <image class="data-card-icon" src="/static/PH.png"/><!--图标设置-->
    <view>
      <view class="data-card-title">
        PH
      </view>
      <view class="data-card-value">
        {{heart}} 度
      </view>
    </view>
  </view>
  <!--浑浊度-->
  <view class="data-card">
    <image class="data-card-icon" src="/static/TDS.png"/><!--图标设置-->
    <view>
      <view class="data-card-title">
        浑浊度
      </view>
      <view class="data-card-value">
        {{heart}} NTU
      </view>
    </view>
  </view>
<!--温控-->
  <view class="data-card">
    <image class="data-card-icon" src="/static/warm.png"/><!--图标设置-->
    <view>
      <view class="data-card-title">
        温控
      </view>
      <view class="data-card-value">
      <switch checked="" bindchange="" color="#3d7ef9"/>
    
      </view>
    </view>
  </view>
</view>
</view>

<canvas canvas-id="myCanvas" style="width: 300px; height: 200px;"></canvas>

<!--页面模板结构文件-->
