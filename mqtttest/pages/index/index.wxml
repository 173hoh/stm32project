<view class="container">
  <view class="MQTTcard">
    <view class="status">
      {{status}}
      <image class="status-icon" src="/assets/check.png"></image>
    </view>
    <view class="message">
      <text>收到的消息:</text>
      <text>{{receivedMessage}}</text>
    </view>
  </view>

  <!-- 数据部分 -->
  <view class="data-container">
    <!-- 温度 -->
    <view class="data-card">
      <image class="data-card-icon" src="/static/temp.png"/>
      <view>
        <view class="data-card-title">温度</view>
        <view class="data-card-value">{{Temp}} ℃</view>
      </view>
    </view>

    <!-- 湿度 -->
    <view class="data-card">
      <image class="data-card-icon" src="/static/humi.png"/>
      <view>
        <view class="data-card-title">湿度</view>
        <view class="data-card-value">{{Humi}} %</view>
      </view>
    </view>

    <!-- 光照 -->
    <view class="data-card">
      <image class="data-card-icon" src="/static/light.png"/>
      <view>
        <view class="data-card-title">光照</view>
        <view class="data-card-value">{{Lux}} Lux</view>
      </view>
    </view>

    <!-- PH -->
    <view class="data-card">
      <image class="data-card-icon" src="/static/PH.png"/>
      <view>
        <view class="data-card-title">PH</view>
        <view class="data-card-value">{{PH}} 度</view>
      </view>
    </view>

    <!-- 浑浊度 -->
    <view class="data-card">
      <image class="data-card-icon" src="/static/TDS.png"/>
      <view>
        <view class="data-card-title">浑浊度</view>
        <view class="data-card-value">{{Tds}} NTU</view>
      </view>
    </view>

    <!-- 水位 (修改错误) -->
    <view class="data-card">
      <image class="data-card-icon" src="/static/water.png"/>  <!-- 这里的图片应更换 -->
      <view>
        <view class="data-card-title">水位</view>  <!-- 这里修正为"水位" -->
        <view class="data-card-value">{{Water}} mm</view>  <!-- 变量改为 waterLevel -->
      </view>
    </view>

  </view> <!-- 这里补上 data-container 的关闭标签 -->
<!-- 可调节变量显示区域 -->
<view class="value-container">
    <view class="value-title">当前调节值:</view>
    <view class="value-display">{{value}}</view>
  </view>
  
  <view class="button-container">
    <button class="control-button" bindtap="increaseValue">+10</button>
    <button class="control-button" bindtap="decreaseValue">-10</button>
  </view>
</view>
