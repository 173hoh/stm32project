/**index.wxss**/
/*ctrl+B快捷编译*/
/*样式设置*/
.container{
  padding:36rpx ;
  justify-content:space-between ;
}
/*UI顶边栏设置*/
.data-container{
  display:flex;
  margin-top: 36rpx;
  flex-direction: row;
  justify-content: space-between;
  /*grid-area: ;*/
  flex-direction: row;
  justify-content: space-between;
  flex-wrap:wrap;/*换行*/
}
.data-container .data-card{
  position: relative;
  background-color: #fff;
  height: 160rpx;
  box-shadow:#d6d6d6 0 0 8rpx;
  border-radius:42rpx ; 
  display: flex;
  justify-content: space-between;/*数据格式居中*/
  padding: 18rpx 18rpx;/*内边距*/
  display: flex;/*自动布局*/
  flex-direction: row ;/*横向布局*/
  flex-wrap:wrap;/*换行*/
  align-items: center;
  justify-content: center;
  width: 280rpx;
  margin: 10rpx;
}
.data-container .data-card .data-card-icon{
  /*图标设置*/
  height: 72rpx;
  width: 72rpx;
}

.data-container .data-card .data-card-title{
  font: size 28rpx; 
  color: #7f7f7f;
}

.data-container .data-card .data-card-value{
  font-size: 52rpx;
  font-weight: bold;
  color: #7f7f7f;
}
 /*页面样式表文件*/ 
 

/* MQTT 状态框 */
.MQTTcard {
  background-color: #e6f7ff; /* 淡蓝色背景 */
  border-radius: 24rpx; /* 圆角 */
  padding: 12rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); /* 轻微阴影 */
  margin-top: 5rpx;
}

/* MQTT 状态文本 */
.status {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #007acc; /* 深蓝色，匹配 MQTT */
  font-weight: bold;
}

/* 状态图标 */
.status-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 16rpx;
}

.MQTTcard {
  width: 90%; /* 让它占满更多空间 */
  max-width: 600rpx; /* 限制最大宽度，防止太宽 */
  background-color: #3d7ef9;
  color: #fff;
  display: flex;
  flex-direction: column; /* 让子元素竖向排列 */
  align-items: center; /* 让内容居中 */
  border-radius: 36rpx; /* 圆角 */
  padding: 48rpx 64rpx; /* 加大内边距 */
  font-size: 32rpx; /* 增加字体大小 */
}

/* MQTT 消息显示 */
.message {
  width: 100%;
  margin-top: 20rpx;
  padding: 48rpx; /* 增大内边距 */
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1); /* 增强阴影 */
}

.message text {
  display: block;
  font-size: 32rpx; /* 增大字体 */
  color: #333;
  margin-bottom: 12rpx; /* 增加间距 */
}
.value-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.value-title {
  font-size: 32rpx;
  color: #555;
  margin-bottom: 10rpx;
}

.value-display {
  font-size: 48rpx;
  font-weight: bold;
  color: #007AFF;
}

.button-container {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 20rpx;
}

.control-button {
  font-size: 36rpx;
  padding: 10rpx 40rpx;
  background-color: #007AFF;
  color: white;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.2);
}

.control-button:active {
  background-color: #005ecb;
}
